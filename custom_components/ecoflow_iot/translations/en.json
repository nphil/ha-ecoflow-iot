  "exceptions": {
    "not_connected": {
      "message": "Cannot {name}: {device} is not connected over Bluetooth."
    },
    "command_failed": {
      "message": "{name} failed: {error}"
    },
    "command_rejected": {
      "message": "The device rejected {name}."
    },
    "device_not_present": {
      "message": "No Bluetooth advertisement has been heard from {address} yet."
    },
    "not_supported": {
      "message": "Device {serial} is not a model this integration supports over Bluetooth."
    },
    "authentication_failed": {
      "message": "The device rejected the stored EcoFlow user ID: {error}"
    },
    "command_timeout": {
      "message": "{name} timed out; the Bluetooth link was released and will be re-established."
    },
    "serial_mismatch": {
      "message": "The device at {address} reports serial {found}, not the configured {expected}. Remove this entry and add the device again."
    },
    "user_id_missing": {
      "message": "No EcoFlow account user ID is stored for this device; every Bluetooth session authenticates with one."
    }
  }
