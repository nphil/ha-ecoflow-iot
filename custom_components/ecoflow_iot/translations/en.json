{
  "issues": {
    "unsupported_device": {
      "title": "Unsupported EcoFlow device ({prefix})",
      "description": "An EcoFlow device with serial prefix `{prefix}` is bound to your account but is not supported yet by this integration, so no entities were created for it. Only the prefix is shown for privacy. To help add support, download this integration's diagnostics (Settings → Devices & Services → EcoFlow IoT → the ⋮ menu → Download diagnostics) — they include the device's raw data under `unmapped_devices` with the serial number removed — and open an issue on the project's GitHub repository including this prefix and the attached diagnostics."
    }
  },
  "config": {
    "step": {
      "user": {
        "title": "EcoFlow IoT",
        "description": "Add an EcoFlow account through the cloud API, or a single device over Bluetooth.",
        "menu_options": {
          "cloud": "EcoFlow account (cloud API)",
          "pick_device": "Bluetooth device"
        }
      },
      "cloud": {
        "title": "EcoFlow IoT",
        "description": "Enter the Access Key and Secret Key from the EcoFlow developer portal (developer.ecoflow.com → Security).",
        "data": {
          "region": "Region",
          "access_key": "Access Key",
          "secret_key": "Secret Key"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate EcoFlow IoT",
        "description": "Your EcoFlow API credentials are no longer valid. Enter updated keys.",
        "data": {
          "region": "Region",
          "access_key": "Access Key",
          "secret_key": "Secret Key"
        }
      },
      "pick_device": {
        "title": "Choose an EcoFlow device",
        "description": "Only supported devices currently being heard over Bluetooth are listed. If yours is missing, wake it up or move it closer to a Bluetooth proxy and try again — these devices advertise only every few seconds.",
        "data": {
          "address": "Device"
        }
      },
      "bluetooth_confirm": {
        "title": "Add {name}",
        "description": "Add the {model} {name} ({address}) over Bluetooth? Home Assistant will hold a connection to it for as long as the device is configured.",
        "data": {
          "device_name": "Name"
        },
        "data_description": {
          "device_name": "The name this device is given in Home Assistant. Entity ids are built from it the moment entities are created, so setting it now avoids renaming everything later - e.g. “Office River 3 Pro”."
        }
      },
      "credentials": {
        "title": "EcoFlow account",
        "description": "{name} encrypts its Bluetooth link with the user ID of the EcoFlow account it is registered to. Enter that ID if you know it, or leave it blank and sign in below to look it up once.",
        "data": {
          "user_id": "User ID",
          "email": "E-mail address or phone number",
          "password": "Password",
          "login_region": "Account region"
        },
        "data_description": {
          "user_id": "The 19-digit ID of your EcoFlow account. It is reused for every Bluetooth device you add, so you are only asked once.",
          "email": "Only used to look the user ID up. Leave blank if you entered the ID above.",
          "password": "Sent once to EcoFlow to fetch the user ID, then discarded. It is never stored.",
          "login_region": "Which EcoFlow server your account lives on. Leave on automatic unless the sign-in fails."
        }
      },
      "reauth_ble": {
        "title": "Re-authenticate {name}",
        "description": "{name} rejected the stored EcoFlow user ID. Enter it again, or sign in to look it up.",
        "data": {
          "user_id": "User ID",
          "email": "E-mail address or phone number",
          "password": "Password",
          "login_region": "Account region"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid Access Key or Secret Key.",
      "cannot_connect": "Failed to connect to the EcoFlow API.",
      "unknown": "Unexpected error.",
      "invalid_user_id": "The user ID must be the digits shown by the EcoFlow account, with nothing else.",
      "user_id_required": "Enter a user ID, or an e-mail address and password to look one up."
    },
    "abort": {
      "already_configured": "This EcoFlow account or device is already configured.",
      "reauth_successful": "Re-authentication was successful.",
      "not_supported": "That Bluetooth device is not an EcoFlow model this integration supports.",
      "no_devices_found": "No supported EcoFlow devices are currently being heard over Bluetooth."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "EcoFlow IoT options",
        "data": {
          "enable_mqtt": "Use MQTT for live data",
          "poll_interval": "HTTP poll interval (seconds)",
          "mqtt_stale_seconds": "MQTT staleness threshold (seconds)",
          "mqtt_refresh_interval": "MQTT active refresh interval (seconds)",
          "mqtt_insecure_tls": "Disable MQTT TLS certificate verification (insecure)",
          "invert_grid_sign": "Invert Stream grid power sign",
          "reset_grid_energy": "Reset grid import/export energy totals & history"
        },
        "data_description": {
          "poll_interval": "How often to poll the HTTP API (fallback when MQTT is unavailable, and the cadence for refreshing HTTP-only values).",
          "mqtt_stale_seconds": "If no MQTT message arrives within this window, the integration polls HTTP.",
          "mqtt_refresh_interval": "How often to actively request a fresh data snapshot over MQTT (publishing a \"latestQuotas\" get, the same thing the EcoFlow app does). Devices slow their push rate when idle, so a passive subscription goes stale even while connected; this keeps the data flowing. Set to 0 to disable and rely only on what the device pushes plus the HTTP fallback.",
          "mqtt_insecure_tls": "Connects to the EcoFlow MQTT broker without verifying its TLS certificate. Only enable this if the connection fails because your system cannot validate the broker's certificate chain — it exposes the broker credentials and all live data to interception. Leave off for normal use.",
          "invert_grid_sign": "Some Stream units report grid power with the sign inverted — they show power fed into the grid as positive instead of negative, the opposite of Home Assistant's convention. This depends on the model and firmware, so it can't be detected automatically. Leave this on (the default) and the sign is corrected: Grid power reads negative while you export, and the Grid import / export energy sensors count in the right direction. Turn it off only if your unit already matches Home Assistant — i.e. exporting to the grid already shows Grid power as negative (import positive, export negative). If you change this setting, also tick \"Reset grid import/export energy totals\" below — the existing totals were built up in the wrong direction and won't correct themselves.",
          "reset_grid_energy": "One-shot action: tick this and save to fully reset the Grid import energy and Grid export energy sensors. It zeroes the live counters and deletes their recorded history and Energy Dashboard statistics, so the old wrong-direction data is gone and they start fresh from zero. Recommended after changing the sign setting above. Leave it off for normal use."
        }
      },
      "ble_options": {
        "title": "Bluetooth device options",
        "data": {
          "update_period": "Update interval (seconds)"
        },
        "data_description": {
          "update_period": "How often the device is asked to report its values over the held Bluetooth connection. Lower is more responsive and uses slightly more airtime; the connection itself is held regardless."
        }
      }
    }
  },
